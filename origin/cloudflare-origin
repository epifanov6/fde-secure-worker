server {
    listen 127.0.0.1:8443 ssl;
    server_name tunnel.fde-stack.online;

    ssl_certificate /etc/letsencrypt/live/tunnel.fde-stack.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tunnel.fde-stack.online/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /secure {
        default_type text/plain;
        return 200 "### Secure path reached successfully ### \n";
    }
}