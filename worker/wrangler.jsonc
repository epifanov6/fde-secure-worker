/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fde-secure-worker",
	"main": "src/entry.py",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "fde-secure-flags",
			"binding": "fde_secure_flags",
			"remote": true
		}
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "tunnel.fde-stack.online/secure",
			"zone_name": "fde-stack.online"
		},
		{
			"pattern": "tunnel.fde-stack.online/secure/*",
			"zone_name": "fde-stack.online"
		}
	]
}